# ==============================================================================
# CORTEXLAB / SCILAB AGENTS - BACKEND ENVIRONMENT VARIABLES
# Arquitetura 100% Zero-Cost (Todos os serviços abaixo possuem cotas gratuitas)
# ==============================================================================

# Server Configuration (Hugging Face Spaces usa a porta 7860)
PORT=7860
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://cortex-lab.vercel.app

# ------------------------------------------------------------------------------
# 1. LLM Providers (Free Tiers com suporte a BYOK)
# ------------------------------------------------------------------------------
# Obtenha gratuitamente em: https://aistudio.google.com/app/apikey (15 RPM / 1M TPM)
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Obtenha gratuitamente em: https://console.groq.com/keys (30 RPM / 6000 TPM)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 2. Supabase Cloud (PostgreSQL + pgvector - Free Tier)
# ------------------------------------------------------------------------------
# Obtenha gratuitamente em: https://supabase.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key_here

# ------------------------------------------------------------------------------
# 3. Open Scientific APIs (100% Públicas e Gratuitas)
# ------------------------------------------------------------------------------
# OpenAlex é 100% aberta; adicione seu e-mail para entrar no pool "polite" (mais rápido)
OPENALEX_POLITE_EMAIL=researcher@cortexlab.ai
# Semantic Scholar API Key (Opcional - a API pública gratuita funciona sem chave)
SEMANTIC_SCHOLAR_API_KEY=
